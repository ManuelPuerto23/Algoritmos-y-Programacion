// Manuel Puerto
// Una tienda ofrece un descuento del 15 % sobre el total de la compra y un cliente desea saber cuanto debera pagar finalmente por esta.
Algoritmo Descuentodecompra
	Definir total_compra, compra_descuento Como Real
	Escribir "Ingrese el total de la compra"
	Leer total_compra
	compra_descuento <- total_compra*0.85
	Escribir "el cliente pagará por la compra: ",compra_descuento
FinAlgoritmo
