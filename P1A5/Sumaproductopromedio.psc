// Manuel Puerto
// Realizar un algoritmo en pseudocodigo que lea 3 número
// Calcule e imprima la suma, el producto y el promedio de estos
Algoritmo Sumaproductopromedio
	Definir numero1, numero2, numero3 Como Entero
	Definir Suma, Producto Como Real
	Definir Promedio Como Real
	Escribir 'ingresa el primer valor'
	Leer numero1
	Escribir 'ingresa el segundo valor'
	Leer numero2
	Escribir 'ingresa el tercer valor'
	Leer numero3
	Suma <- numero1+numero2+numero3
	Producto <- numero1*numero2*numero3
	Promedio <- Suma/3
	Escribir 'Los resultados de la Suma, el Producto y el Promedio son: '
	Escribir Suma
	Escribir Producto
	Escribir Promedio
FinAlgoritmo
