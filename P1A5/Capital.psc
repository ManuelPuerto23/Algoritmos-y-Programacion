// Manuel Puerto
//Una persona invierte su capital en un banco y desea saber cuanto dinero ganara despues de un mes si la entidad paga a razon del 2 % mensual.
Algoritmo Capital
	Definir Capiital Como Entero
	Definir Ganancia Como Entero
	Definir Total Como Entero
	Escribir "Ingresa el capital que se invertirá en el banco"
	Leer Capiital
	Ganancia <- Capiital*0.02
	Total <- Capiital+Ganancia
	Escribir "La ganancia será de: ", Ganancia
	Escribir "El total será de: ", Total	
FinAlgoritmo
