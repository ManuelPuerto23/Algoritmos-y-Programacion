// Realizar un algoritmo en pseudocodigo para convertir grados Celsius a grados Kelvin y Fahrenheit.
Algoritmo Celsiuskelvinfahrenheit
	Definir Celsius, Kelvin, Fahrenheit Como Real
	
	Escribir "Ingresa la temperatura en grados Celsius"
	Leer Celsius
	Kelvin <- Celsius + 273.15
	Fahrenheit <- Celsius * 1.8 + 32
	
	Escribir "La temperatura en grados kelvin son: ", Kelvin, " K"
	Escribir "La temperatura en grados fahrenheit son: ", Fahrenheit, " F"
FinAlgoritmo
